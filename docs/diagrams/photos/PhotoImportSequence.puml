@startuml
!include ../shared/UmlStyle.iuml
scale max 760 width
title Importing a photo into an event
caption Successful addPhoto e/TAG p/PATH
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #F1F6FC
skinparam ParticipantBorderColor #40566B
skinparam ArrowColor #40566B
hide footbox

actor User
participant "AddPhotoCommand" as Command
participant "club:Club" as Club
participant "event:Event" as Event
participant "photo:Photo" as Photo
participant "File system" as FS

User -> Command : addPhoto(...)
activate Command
Command -> Club : addPhoto(tag, path, name)
activate Club
Club -> Club : findEventByTag(tag)
Club -> Event : addPhoto(path, name)
activate Event
create Photo
Event -> Photo : new Photo(source, destination, name)
activate Photo
Photo -> FS : validate source and destination
FS --> Photo : valid
Photo -> FS : read image; write PNG
FS --> Photo : saved
Photo --> Event : photo
deactivate Photo
Event -> Event : photos.put(name, photo)
Event --> Club : photo
deactivate Event
Club -> Club : unsavedChanges = true
Club --> Command : photo
deactivate Club
Command --> User : success message
deactivate Command
@enduml
