@startuml
title Finding events
caption Partial execution view - findEvent s/pending max/500
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam titleFontSize 16
skinparam sequenceMessageFontSize 16
skinparam sequenceParticipantFontSize 16
skinparam sequenceReferenceFontSize 16
skinparam sequenceGroupFontSize 16
skinparam sequenceGroupHeaderFontSize 16
skinparam captionFontSize 16
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #F1F6FC
skinparam ParticipantBorderColor #40566B
skinparam ArrowColor #40566B
hide footbox

participant "command:FindEventCommand" as Command
participant "search:EventSearch" as Search
participant "club:Club" as Club
participant "ui:UserInterface" as UI

[-> Command : execute(args)
activate Command
Command -> Command : validateArgs(args)
activate Command
||15||
Command --> Command
deactivate Command

Command -> Search : search(args)
activate Search
ref over Search
Build one predicate
per supplied filter
end ref

Search -> Club : getEvents()
activate Club
||15||
Club --> Search : current event snapshot
deactivate Club

ref over Search, Club
Select events satisfying every predicate;
retain snapshot order
end ref

alt no matches
    Search -> UI : print("No matching events found.")
else matches found
    ref over Search, UI
    Print count, then each event's tag and name
    end ref
end

Search --> Command
deactivate Search
[<-- Command : False
deactivate Command
@enduml
