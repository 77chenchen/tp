@startuml
!include ../shared/UmlStyle.iuml
scale max 760 width
title Switching clubs
caption Successful switchClub n/chess
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #F1F6FC
skinparam ParticipantBorderColor #40566B
skinparam ArrowColor #40566B
hide footbox

participant "command:SwitchClubCommand" as Command
participant "manager:ClubManager" as Manager
participant "storage:SaveLoadManager" as Storage
participant "club:Club" as Club
participant "ui:UserInterface" as UI

[-> Command : execute(args)
activate Command
Command -> Manager : switchClub("chess")
activate Manager
note over Manager : Verify target exists
Manager -> Manager : saveActiveClub()
Manager -> Storage : save(activeClub, currentFile)
activate Storage
Storage --> Manager
deactivate Storage
Manager -> Storage : load(targetFile)
activate Storage
Storage --> Manager : loadedClub
deactivate Storage
Manager -> Club : replaceWith(loadedClub)
activate Club
Club --> Manager
deactivate Club
Manager -> Club : markSaved()
activate Club
Club --> Manager
deactivate Club
Manager -> Manager : activeClubId = "chess"
Manager --> Command
deactivate Manager
Command -> UI : print("Active club: chess")
[<-- Command : false
deactivate Command
@enduml
