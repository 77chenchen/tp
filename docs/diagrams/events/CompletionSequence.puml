@startuml
!include ../shared/UmlStyle.iuml
scale max 760 width
title Setting event completion
caption mark and unmark share the same path
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #F1F6FC
skinparam ParticipantBorderColor #40566B
skinparam ArrowColor #40566B
hide footbox

participant "command:CompletionCommand" as Command
participant "handler:EventCompletion" as Handler
participant "club:Club" as Club
participant "event:Event" as Event
participant "ui:UserInterface" as UI

[-> Command : execute(args)
activate Command
Command -> Handler : setCompleted("TAG", completed)
activate Handler
Handler -> Club : findEventByTag("TAG")
activate Club
Club --> Handler : event
deactivate Club
Handler -> Event : isCompleted()
activate Event
Event --> Handler : currentState
deactivate Event
opt state differs
    Handler -> Event : withCompleted(completed)
    activate Event
    Event --> Handler : updatedEvent
    deactivate Event
    Handler -> Club : updateEvent(updatedEvent)
    activate Club
    Club --> Handler : true
    deactivate Club
end
Handler -> UI : print(message)
Handler --> Command
deactivate Handler
[<-- Command : false
deactivate Command
@enduml
