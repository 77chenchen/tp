@startuml
!include ../shared/UmlStyle.iuml
!pragma layout smetana
title Event search structure
caption Partial class view
skinparam shadowing false
skinparam classBackgroundColor #F1F6FC
skinparam classBorderColor #40566B
skinparam ArrowColor #40566B
skinparam classAttributeIconSize 0
hide circle
hide empty members

class FindEventCommand {
  +validateArgs(args)
  +execute(args)
}
class EventSearch {
  +search(filters)
}
class Club
class Event

FindEventCommand --> EventSearch : eventSearch
EventSearch --> Club : club
' Trailing spaces offset the end multiplicity from the curved connector.
Club --> "0..*    " Event : events
EventSearch ..> Event : filters
@enduml
