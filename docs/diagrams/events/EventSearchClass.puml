@startuml
!include ../shared/UmlStyle.iuml
!pragma layout smetana
title Event search structure
caption Validation, matching, and current club data
skinparam shadowing false
skinparam classBackgroundColor #F1F6FC
skinparam classBorderColor #40566B
skinparam ArrowColor #40566B
skinparam classAttributeIconSize 0
hide circle
hide empty members

class FindEventCommand {
  +validateArgs(args)
  +execute(args)
}
class EventSearch {
  +search(filters)
}
class Club
class Event

FindEventCommand --> EventSearch : delegates search >
EventSearch --> Club : obtains snapshot >
Club --> "0..*" Event : contains >
EventSearch ..> Event : tests predicates >
@enduml
