@startuml
!include ../shared/UmlStyle.iuml
scale max 760 width
title Finding events
caption findEvent s/pending max/500
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #F1F6FC
skinparam ParticipantBorderColor #40566B
skinparam ArrowColor #40566B
hide footbox

participant "command:FindEventCommand" as Command
participant "search:EventSearch" as Search
participant "club:Club" as Club
participant "ui:UserInterface" as UI

[-> Command : execute(args)
activate Command
Command -> Command : validateArgs(args)
Command -> Search : search(args)
activate Search
Search -> Search : compile predicates once
Search -> Club : getEvents()
activate Club
Club --> Search : event snapshot
deactivate Club
Search -> Search : retain events matching all filters
alt no matches
    Search -> UI : print("No matching events found.")
else matches found
    Search -> UI : print(result count)
    loop each match
        Search -> UI : print(event tag and name)
    end
end
Search --> Command
deactivate Search
[<-- Command : false
deactivate Command
@enduml
