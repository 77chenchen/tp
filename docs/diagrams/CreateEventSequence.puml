@startuml
title Creating an event
caption Command processing view - successful createEvent e/TAG
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam titleFontSize 16
skinparam sequenceMessageFontSize 16
skinparam sequenceParticipantFontSize 16
skinparam sequenceReferenceFontSize 16
skinparam captionFontSize 16
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #F1F6FC
skinparam ParticipantBorderColor #40566B
skinparam ArrowColor #40566B
hide footbox

participant "parser:CommandParser" as Parser
participant "command:CreateEventCommand" as Command
participant "EventArgumentValidator" as Validator
participant "event:Event" as Event
participant "club:Club" as Club
participant "ui:UserInterface" as UI

[-> Parser : parse("createEvent e/TAG")
activate Parser
Parser -> Parser : separate(input)
Parser -> Parser : parseArgs(tokens, command)
activate Parser
Parser -> Command : validateArgs(args)
activate Command
Command -> Validator : validate(args)
activate Validator
||15||
Validator --> Command
deactivate Validator
Command --> Parser
deactivate Command
Parser --> Parser : args
deactivate Parser
Parser -> Command : execute(args)
activate Command
create Event
Command -> Event : new Event(...)
activate Event
||25||
Event --> Command
deactivate Event
Command -> Club : addEvent(event)
activate Club
Club -> Club : findEventByTag("TAG")
Club --> Command : True
deactivate Club
Command -> UI : print("Created event: TAG")
Command --> Parser : False
deactivate Command
[<-- Parser : False
deactivate Parser
@enduml
