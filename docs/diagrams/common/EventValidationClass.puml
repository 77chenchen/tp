@startuml
!include ../shared/UmlStyle.iuml
!pragma layout smetana
title Shared event command validation
caption Both commands use the same field rules
skinparam shadowing false
skinparam classBackgroundColor #F1F6FC
skinparam classBorderColor #40566B
skinparam ArrowColor #40566B
skinparam classAttributeIconSize 0
hide members
hide circle

class CommandParser
abstract class Command
class CreateEventCommand
class EditEventCommand
class EventArgumentValidator

CommandParser --> "0..*" Command : dispatches >
Command <|-- CreateEventCommand
Command <|-- EditEventCommand
CreateEventCommand ..> EventArgumentValidator : validates with >
EditEventCommand ..> EventArgumentValidator : validates with >
@enduml
