@startuml
!include ../shared/UmlStyle.iuml
title Command processing classes
caption Command registration and dispatch
top to bottom direction
skinparam shadowing false
skinparam ArrowColor #40566B
skinparam classBackgroundColor #F1F6FC
skinparam classBorderColor #40566B
skinparam classAttributeIconSize 0
hide circle
hide empty members

class ClubFlow
class CommandParser {
  +register(keyword, command)
  +registerAlias(keyword, alias)
  +suggestedCorrection(input): Optional<String>
  +parse(input): boolean
}
abstract class Command {
  +requiredArgIds(): String[]
  +validateArgs(args)
  +execute(args): boolean
}
class FindMemberCommand {
  +execute(args): boolean
}
class XYZCommand
class Club
class UserInterface {
  +confirmCorrection(input): boolean
}

ClubFlow *-- CommandParser
CommandParser --> "0..*" Command : dispatches >
Command <|-- FindMemberCommand
Command <|-- XYZCommand
FindMemberCommand --> Club : searches >
Command --> UserInterface : displays via >
@enduml
