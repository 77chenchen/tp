@startuml
!include ../shared/UmlStyle.iuml
title UI component
caption Partial class diagram - shared terminal interface
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam ClassBackgroundColor #F1F6FC
skinparam ClassBorderColor #40566B
skinparam ArrowColor #40566B
hide empty members

class ClubFlow {
    - ui: UserInterface
    - parser: CommandParser
    + run(): void
}
class CommandParser {
    - ui: UserInterface
    + parse(input: String): boolean
}
abstract class Command {
    # ui: UserInterface
    + execute(args): boolean
}
class UserInterface {
    + welcome(): void
    + prompt(): String
    + print(message: String): void
}

ClubFlow --> CommandParser : parses input
ClubFlow --> UserInterface : prompts
CommandParser --> Command : dispatches
Command --> UserInterface : prints
@enduml
