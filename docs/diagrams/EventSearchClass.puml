@startuml
!pragma layout smetana
title Event search structure
caption Partial class view
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam defaultFontSize 16
skinparam titleFontSize 16
skinparam captionFontSize 16
skinparam classBackgroundColor #F1F6FC
skinparam classBorderColor #40566B
skinparam ArrowColor #40566B
skinparam classAttributeIconSize 0
hide circle
hide empty members

class FindEventCommand {
  +validateArgs(args)
  +execute(args)
}
class EventSearch {
  +search(filters)
}
class Club
class Event

FindEventCommand --> EventSearch : eventSearch
EventSearch --> Club : club
Club --> "0..*" Event : events
EventSearch ..> Event : filters
@enduml
